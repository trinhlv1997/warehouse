# ===== Frontend (Vite) — chỉ biến có tiền tố VITE_ được đưa vào bundle, KHÔNG đặt secret ở đây =====
# Để trống = dùng URL tương đối (/api) — frontend và API cùng domain (mặc định trên Cloudflare).
VITE_API_BASE_URL=
VITE_DEFAULT_LOCALE=vi

# ===== Backend (Worker) — cấu hình qua wrangler.jsonc "vars" và secrets =====
# Các biến dưới đây chỉ để tham khảo; trên Cloudflare đặt bằng wrangler.jsonc / `wrangler secret put`.
APP_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
DATABASE_PROVIDER=d1
STORAGE_PROVIDER=r2
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEMO_MODE=true
# Secret: đặt bằng `npx wrangler secret put SESSION_SECRET` (production) hoặc .dev.vars (local)
SESSION_SECRET=
