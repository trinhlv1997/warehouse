{
  "name": "warehouse-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "hono": "^4.13.21",
    "i18next": "^27.2.6",
    "lucide-react": "^1.79.0",
    "pdfmake": "^0.3.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/generate-seed.ts && wrangler d1 execute DB --local --file database/seeds/seed.generated.sql",
    "db:seed:remote": "tsx scripts/generate-seed.ts && wrangler d1 execute DB --remote --file database/seeds/seed.generated.sql",
    "db:reset:local": "tsx scripts/generate-seed.ts --reset && wrangler d1 execute DB --local --file database/seeds/seed.generated.sql",
    "db:reset:remote": "tsx scripts/generate-seed.ts --reset && wrangler d1 execute DB --remote --file database/seeds/seed.generated.sql",
    "setup": "npm run db:migrate:local && npm run db:seed:local"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
